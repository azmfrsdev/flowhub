{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "schema": "tsx scripts/generate-schema.ts",
    "schema:check": "tsx scripts/generate-schema.ts --check",
    "sample": "tsx --tsconfig tsconfig.json scripts/write-sample.ts",
    "check-models": "tsx scripts/check-models.ts",
    "emulators": "tsx scripts/emulators.ts",
    "deploy": "tsx scripts/deploy.ts",
    "eval": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval.ts",
    "sample-logos": "tsx --tsconfig tsconfig.json scripts/sample-logos.ts"
  },
  "dependencies": {
    "@google-cloud/tasks": "^7.3.0",
    "@google/genai": "^2.29.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "pptxgenjs": "4.0.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}

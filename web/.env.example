# Copy to .env.local for local development. Never commit real values.
# Secrets don't belong here at all: deployed values come from Cloud Run
# environment variables and Secret Manager.

# --- Gemini: the real project, called with your gcloud sign-in (ADC) ---
GOOGLE_CLOUD_PROJECT=your-project-id
# Where the pinned Gemini models are served (see npm run check-models).
GOOGLE_CLOUD_LOCATION=global

# --- Firebase: locally, the emulators under a demo- project, so no real data is touched ---
FIREBASE_PROJECT_ID=demo-flowhub
STORAGE_BUCKET=demo-flowhub.appspot.com

# --- Firebase web config: public by design, fixed at image build time ---
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-flowhub.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-flowhub
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app

# --- Local development: Admin SDK and browser use the emulators ---
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
NEXT_PUBLIC_USE_EMULATORS=true

# --- Cloud Tasks (deployed only, ADR-0006 D6) ---
TASKS_LOCATION=asia-southeast1
TASKS_QUEUE=run-stage
# Service account Cloud Tasks signs its OIDC token as; the internal route accepts only this.
TASKS_INVOKER_SA=
# Public URL of this Cloud Run service, used as the task target and OIDC audience.
APP_BASE_URL=

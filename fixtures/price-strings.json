{
  "description": "Free-text prices and their expected parses (ADR-0001 D6). The TypeScript parser in web/src/lib/pricing/parse.ts must pass every case.",
  "defaultCurrency": "MYR",
  "cases": [
    { "text": "RM 9,500", "expect": { "kind": "amount", "currency": "MYR", "amount": 9500 } },
    { "text": "RM 18,000", "expect": { "kind": "amount", "currency": "MYR", "amount": 18000 } },
    { "text": "RM 0.80 / GB", "expect": { "kind": "amount", "currency": "MYR", "amount": 0.8, "per": "GB" } },
    { "text": "RM 380 / VM, min 50 VMs", "expect": { "kind": "amount", "currency": "MYR", "amount": 380, "per": "VM", "minQuantity": 50 } },
    { "text": "RM 8,000 per DB", "expect": { "kind": "amount", "currency": "MYR", "amount": 8000, "per": "DB" } },
    { "text": "RM 2,800 per dashboard", "expect": { "kind": "amount", "currency": "MYR", "amount": 2800, "per": "dashboard" } },
    { "text": "RM 4,500 / month", "expect": { "kind": "amount", "currency": "MYR", "amount": 4500, "recurring": "month" } },
    { "text": "RM 1,200 per month", "expect": { "kind": "amount", "currency": "MYR", "amount": 1200, "recurring": "month" } },
    { "text": "RM 25 / user, min RM 5,000", "expect": { "kind": "amount", "currency": "MYR", "amount": 25, "per": "user", "minAmount": 5000 } },
    { "text": "RM 3,000 per event", "expect": { "kind": "amount", "currency": "MYR", "amount": 3000, "per": "event" } },
    { "text": "SGD 1,250.50", "expect": { "kind": "amount", "currency": "SGD", "amount": 1250.5 } },
    { "text": "USD 499", "expect": { "kind": "amount", "currency": "USD", "amount": 499 } },
    { "text": "1.5%", "expect": { "kind": "percent", "rate": 1.5 } },
    { "text": "1.2% min RM 0.20", "expect": { "kind": "percent", "rate": 1.2, "minAmount": 0.2, "currency": "MYR" } },
    { "text": "Waived", "expect": { "kind": "waived" } },
    { "text": "On quote", "expect": { "kind": "on_quote" } },
    { "text": "on request", "expect": { "kind": "on_quote" } },
    { "text": "Included", "expect": { "kind": "included" } },
    { "text": "Quarterly", "expect": { "kind": "unparsed" } },
    { "text": "Not offered", "expect": { "kind": "unparsed" } },
    { "text": "18000", "expect": { "kind": "amount", "currency": "MYR", "amount": 18000 } },
    { "text": "RM 9 / employee / month", "expect": { "kind": "amount", "currency": "MYR", "amount": 9, "per": "employee", "recurring": "month" } },
    { "text": "USD 2.50 / employee / month", "expect": { "kind": "amount", "currency": "USD", "amount": 2.5, "per": "employee", "recurring": "month" } },
    { "text": "RM 119 / device / month", "expect": { "kind": "amount", "currency": "MYR", "amount": 119, "per": "device", "recurring": "month" } },
    { "text": "RM 450 / hiring site / month", "expect": { "kind": "amount", "currency": "MYR", "amount": 450, "per": "hiring site", "recurring": "month" } },
    { "text": "RM 380 / unit / year", "expect": { "kind": "amount", "currency": "MYR", "amount": 380, "per": "unit", "recurring": "year" } },
    { "text": "RM 3 / device / week", "expect": { "kind": "amount", "currency": "MYR", "amount": 3, "per": "device", "recurring": "week" } },
    { "text": "RM 9 per employee per month", "expect": { "kind": "amount", "currency": "MYR", "amount": 9, "per": "employee", "recurring": "month" } },
    { "text": "RM 5 / GB / VM", "expect": { "kind": "unparsed" } },
    { "text": "RM 0.035 / page", "expect": { "kind": "amount", "currency": "MYR", "amount": 0.035, "per": "page" } },
    { "text": "RM 1.20 / kg, min RM 300", "expect": { "kind": "amount", "currency": "MYR", "amount": 1.2, "per": "kg", "minAmount": 300 } },
    { "text": "RM 65 / device, min RM 1,500", "expect": { "kind": "amount", "currency": "MYR", "amount": 65, "per": "device", "minAmount": 1500 } },
    { "text": "99.9% uptime", "expect": { "kind": "unparsed" } },
    { "text": "Next business day", "expect": { "kind": "unparsed" } },
    { "text": "36 months", "expect": { "kind": "unparsed" } },
    { "text": "1 entity", "expect": { "kind": "unparsed" } },
    { "text": "20% of the build price per year", "expect": { "kind": "unparsed" } }
  ]
}
